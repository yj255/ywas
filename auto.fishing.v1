-- Bloxspin Auto Fishing + Remote Intercept (Press Q to Toggle)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local AutoFish = false
local CastCFrame = nil

-- إنشاء واجهة معلومات شاشة صغيرة
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BloxspinAutoFishQ"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 230, 0, 100)
MainFrame.Position = UDim2.new(0.05, 0, 0.35, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "Bloxspin Auto Fish (Q Toggle)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 13
Title.Font = Enum.Font.GothamBold
Title.BackgroundTransparency = 1
Title.Parent = MainFrame

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 25)
StatusLabel.Position = UDim2.new(0, 0, 0.35, 0)
StatusLabel.Text = "الحالة: متوقف (OFF)"
StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
StatusLabel.TextSize = 13
StatusLabel.Font = Enum.Font.GothamBold
StatusLabel.BackgroundTransparency = 1
StatusLabel.Parent = MainFrame

local InfoLabel = Instance.new("TextLabel")
InfoLabel.Size = UDim2.new(1, 0, 0, 25)
InfoLabel.Position = UDim2.new(0, 0, 0.68, 0)
InfoLabel.Text = "اضغط بالماوس للـ Position ثم اضغط Q"
InfoLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
InfoLabel.TextSize = 11
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.BackgroundTransparency = 1
InfoLabel.Parent = MainFrame

-- 1. تحديد موقع رمي السنارة بالماوس
Mouse.Button1Down:Connect(function()
	if not AutoFish and Mouse.Target then
		CastCFrame = Mouse.Hit
		InfoLabel.Text = "تم تثبيت الموقع بنجاح!"
		InfoLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
	end
end)

-- 2. تفعيل وإيقاف السكربت عند الضغط على زر Q
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.Q then
		AutoFish = not AutoFish
		if AutoFish then
			StatusLabel.Text = "الحالة: شغال (ON)"
			StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 100)
		else
			StatusLabel.Text = "الحالة: متوقف (OFF)"
			StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
		end
	end
end)

-- 3. الموتور المباشر لحل الميني قيم ورمي السنارة
task.spawn(function()
	while task.wait(0.05) do
		if AutoFish then
			local Char = LocalPlayer.Character
			if Char then
				local Tool = Char:FindFirstChildOfClass("Tool")
				
				-- إطلاق السنارة
				if Tool then
					Tool:Activate()
				end
				
				-- إنهاء الميني قيم تلقائياً عبر استدعاء الـ Events الداخلية
				local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
				if PlayerGui then
					for _, v in pairs(PlayerGui:GetDescendants()) do
						if v:IsA("RemoteEvent") or v:IsA("BindableEvent") then
							if v.Name:lower():find("fish") or v.Name:lower():find("win") or v.Name:lower():find("game") then
								v:FireServer(true)
							end
						end
					end
				end
			end
		end
	end
end)
