-- الترانزيت ومعالجة الخطأ
local function TeleportToJobId(jobId)
    if not jobId or jobId == "" then
        StatusLabel.Text = "⚠️ يرجى إدخال JobId أولاً"
        return
    end
    
    StatusLabel.Text = "⏳ جاري محاولة الاتصال بالسيرفر..."
    
    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
    end)
    
    if not success then
        StatusLabel.Text = "❌ السيرفر غير متاح أو ممتلئ!"
        warn("Teleport Failed: " .. tostring(err))
    end
end

-- الإشعار بالأخطاء التي ترجعها روبلوكس
TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    StatusLabel.Text = "❌ فشل الدخول: السيرفر غير متاح"
end)

JoinButton.MouseButton1Click:Connect(function()
    TeleportToJobId(TextBox.Text)
end)

CopyButton.MouseButton1Click:Connect(function()
    local currentJobId = game.JobId
    if setclipboard then
        setclipboard(currentJobId)
        CopyButton.Text = "تم النسخ بنجاح! ✓"
        task.wait(2)
        CopyButton.Text = "نسخ JobId السيرفر الحالي"
    else
        TextBox.Text = currentJobId
    end
end)
